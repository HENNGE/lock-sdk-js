{
	"name": "@hennge/lock-sdk-js",
	"version": "0.0.0",
	"description": "TypeScript SDK for setting up HENNGE Lock",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HENNGE/lock-sdk-js.git"
	},
	"bugs": {
		"url": "https://github.com/HENNGE/lock-sdk-js/issues"
	},
	"homepage": "https://github.com/HENNGE/lock-sdk-js#readme",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "pnpm typecheck && tsdown && tsup && pnpm check-types",
		"typecheck": "tsc",
		"check-types": "attw --pack . --exclude-entrypoints global",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write --unsafe",
		"prepublishOnly": "pnpm build",
		"release": "pnpm changeset publish"
	},
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"./global": "./dist/index.global.js"
	},
	"files": ["dist"],
	"keywords": [],
	"author": "HENNGE",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.10.0",
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.1",
		"@biomejs/biome": "1.9.4",
		"@changesets/changelog-github": "0.5.2",
		"@changesets/cli": "2.29.8",
		"@swc/core": "1.11.24",
		"@types/node": "22.15.19",
		"tsdown": "0.11.11",
		"tsup": "8.5.0",
		"typescript": "5.8.3"
	},
	"dependencies": {
		"zod": "4.3.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild"]
	}
}
