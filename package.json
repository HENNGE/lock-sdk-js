{
	"name": "@hennge/lock-sdk-js",
	"version": "1.0.0",
	"description": "TypeScript SDK for setting up HENNGE Lock",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HENNGE/lock-sdk-js.git"
	},
	"bugs": {
		"url": "https://github.com/HENNGE/lock-sdk-js/issues"
	},
	"homepage": "https://github.com/HENNGE/lock-sdk-js#readme",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "pnpm typecheck && tsdown && tsup && publint && pnpm check-types",
		"typecheck": "tsc",
		"check-types": "attw --pack . --profile esm-only",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write --unsafe",
		"prepublishOnly": "pnpm build",
		"release": "pnpm changeset publish",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"unpkg": "./dist/index.global.js",
	"jsdelivr": "./dist/index.global.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"keywords": [],
	"author": "HENNGE",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.7.0",
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.14",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@swc/core": "1.16.2",
		"@types/node": "24.19.0",
		"@vitest/coverage-v8": "5.0.1",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"dependencies": {
		"zod": "4.5.4"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
