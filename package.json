{
	"name": "@hennge/lock-sdk-js",
	"version": "0.0.1",
	"description": "TypeScript SDK for setting up HENNGE Lock",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "pnpm typecheck && tsdown && tsup && publint && pnpm check-types",
		"typecheck": "tsc",
		"check-types": "attw --pack . --profile esm-only",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write --unsafe"
	},
	"unpkg": "./dist/index.global.js",
	"jsdelivr": "./dist/index.global.js",
	"files": ["dist"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"keywords": [],
	"author": "HENNGE",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.25.0",
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.12",
		"@swc/core": "1.16.2",
		"@types/node": "24.13.4",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"tsup": "8.5.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"zod": "4.5.4"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
