{
	"name": "@hennge/lock-sdk-js",
	"version": "0.0.1",
	"description": "TypeScript SDK for setting up HENNGE Lock",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "pnpm typecheck && tsdown && tsup && pnpm check-types",
		"typecheck": "tsc",
		"check-types": "attw --pack . --exclude-entrypoints global",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write --unsafe"
	},
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"require": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"./global": "./dist/index.global.js"
	},
	"keywords": [],
	"author": "HENNGE",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.25.0",
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.12",
		"@types/node": "25.9.5",
		"tsdown": "0.23.0",
		"tsup": "8.5.1",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"zod": "4.5.4"
	}
}
